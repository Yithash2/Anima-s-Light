--- !u!114 &127418899
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 127418898}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 523c2b9ef4b661e4aa8dfe8bfe3af26f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _dialogues:
  - lines:
    - text: Bonjour ..
      _lineTime: 2
      IsKnown: 0
      character: {fileID: 11400000, guid: cbf06e4614e8cd64698e2f9f43ffc3f3, type: 2}
    - text: Je suis ce que vous appelerais "Dieu"
      _lineTime: 1
      IsKnown: 0
      character: {fileID: 11400000, guid: cbf06e4614e8cd64698e2f9f43ffc3f3, type: 2}
    - text: "M\xEAme si c'est un peu plus compliqu\xE9 que cela"
      _lineTime: 1
      IsKnown: 0
      character: {fileID: 11400000, guid: cbf06e4614e8cd64698e2f9f43ffc3f3, type: 2}
    - text: "Je suis ici pour te donner une qu\xEAte."
      _lineTime: 1
      IsKnown: 0
      character: {fileID: 11400000, guid: cbf06e4614e8cd64698e2f9f43ffc3f3, type: 2}
    - text: "Fini cet d\xE9monstration pour le salon du jeu vid\xE9o toulousain,
        et si tu es un des 5 plus rapide .."
      _lineTime: 1
      IsKnown: 0
      character: {fileID: 11400000, guid: cbf06e4614e8cd64698e2f9f43ffc3f3, type: 2}
    - text: "Tu gagneras une cl\xE9 pour le premier chapitre du jeu quand il sera
        sorti"
      _lineTime: 1
      IsKnown: 0
      character: {fileID: 11400000, guid: cbf06e4614e8cd64698e2f9f43ffc3f3, type: 2}
    - text: "Maintenant va en passant a travers les nuages en appuyant sur la touche
        mythique \"S\" ou la fameuse \"fl\xE9che du bas\""
      _lineTime: 1
      IsKnown: 0
      character: {fileID: 11400000, guid: cbf06e4614e8cd64698e2f9f43ffc3f3, type: 2}
    LineIndex: 0
  CurrentDialogue: 0
